	./main --input ./bins/test-kernel.bin --nsteps 25 --dt 1e-4 --eps 0.05 --energy-every 25 --output ./bins/b.out --kernel "b" --profiler 1 --papi 1 --profiler-path ./profilings/b.txt ; \
